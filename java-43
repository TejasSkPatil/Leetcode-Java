class Solution {
    private int maxSum;

    public int maxPathSum(TreeNode root) {
        maxSum = Integer.MIN_VALUE;
        maxGain(root);
        return maxSum;
    }

    private int maxGain(TreeNode node) {
        if (node == null) {
            return 0;
        }

        // Recursively compute the maximum path sum of left and right subtrees.
        // We take Math.max(0, ...) to ignore paths with a negative sum.
        int leftGain = Math.max(maxGain(node.left), 0);
        int rightGain = Math.max(maxGain(node.right), 0);

        // The path sum including both left and right children and the current node
        int currentPathSum = node.val + leftGain + rightGain;

        // Update the global maximum with the path sum going through the current node
        maxSum = Math.max(maxSum, currentPathSum);

        // Return the maximum sum that can be extended to the parent node
        return node.val + Math.max(leftGain, rightGain);
    }
}
