class Solution {
    public int canCompleteCircuit(int[] gas, int[] cost) {
        int totalGas = 0;
        int totalCost = 0;
        int tank = 0;
        int startPoint = 0;

        for (int i = 0; i < gas.length; i++) {
            totalGas += gas[i];
            totalCost += cost[i];
            tank += gas[i] - cost[i];

            // If tank drops below 0, the current starting station (and any before it) is invalid
            if (tank < 0) {
                startPoint = i + 1; // Try the next station as the starting point
                tank = 0;           // Reset current tank fuel
            }
        }

        // If total gas is less than total cost, completing the circuit is impossible
        return totalGas >= totalCost ? startPoint : -1;
    }
}
