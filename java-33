class Solution {
    public boolean isSameTree(TreeNode p, TreeNode q) {
        // If both nodes are null, the trees are structurally identical up to this point
        if (p == null && q == null) {
            return true;
        }
        
        // If only one node is null, the structures do not match
        if (p == null || q == null) {
            return false;
        }
        
        // If the values do not match, the trees are not the same
        if (p.val != q.val) {
            return false;
        }
        
        // Recursively check if the left subtrees and right subtrees match
        return isSameTree(p.left, q.left) && isSameTree(p.right, q.right);
    }
}
