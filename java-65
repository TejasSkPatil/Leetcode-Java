import java.util.List;
import java.util.Objects;

public class Solution {
    // Mimicking the Employee table structure
    public static class Employee {
        int id;
        Integer salary;

        public Employee(int id, Integer salary) {
            this.id = id;
            this.salary = salary;
        }
    }

    public Integer getSecondHighestSalary(List<Employee> employees) {
        return employees.stream()
                .map(e -> e.salary)
                .filter(Objects::nonNull)              // Filter out null salaries
                .distinct()                             // Ensure unique salary values
                .sorted((a, b) -> Integer.compare(b, a)) // Sort descending
                .skip(1)                                // Skip the highest salary
                .findFirst()                            // Take the second highest
                .orElse(null);                          // Return null if it doesn't exist
    }
}
