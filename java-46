// Definition for a binary tree node provided by LeetCode.
class TreeNode {
    int val;
    TreeNode left;
    TreeNode right;
    TreeNode() {}
    TreeNode(int val) { this.val = val; }
    TreeNode(int val, TreeNode left, TreeNode right) {
        this.val = val;
        this.left = left;
        this.right = right;
    }
}

class Solution {
    public boolean isValidBST(TreeNode root) {
        // Use null to represent negative and positive infinity boundaries
        return validate(root, null, null);
    }

    private boolean validate(TreeNode node, Integer low, Integer high) {
        // Base case: an empty tree or sub-tree is a valid BST
        if (node == null) {
            return true;
        }

        // The current node's value must be strictly greater than the low boundary
        if (low != null && node.val <= low) {
            return false;
        }

        // The current node's value must be strictly less than the high boundary
        if (high != null && node.val >= high) {
            return false;
        }

        // Recursively validate subtrees with updated boundaries
        // Left subtree values must be less than node.val (update high boundary)
        // Right subtree values must be greater than node.val (update low boundary)
        return validate(node.left, low, node.val) && validate(node.right, node.val, high);
    }
}
