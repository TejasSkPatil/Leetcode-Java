class Solution {
    public int trap(int[] height) {
        // Return 0 if the array is empty or has fewer than 3 blocks (cannot trap water)
        if (height == null || height.length < 3) {
            return 0;
        }

        int left = 0;
        int right = height.length - 1;
        
        int leftMax = 0;
        int rightMax = 0;
        
        int totalWater = 0;

        // Move pointers toward each other until they meet
        while (left < right) {
            // The water height is bounded by the smaller of the two sides
            if (height[left] < height[right]) {
                // Update leftMax or calculate trapped water at the current left block
                if (height[left] >= leftMax) {
                    leftMax = height[left];
                } else {
                    totalWater += leftMax - height[left];
                }
                left++; // Move the left pointer inward
            } else {
                // Update rightMax or calculate trapped water at the current right block
                if (height[right] >= rightMax) {
                    rightMax = height[right];
                } else {
                    totalWater += rightMax - height[right];
                }
                right--; // Move the right pointer inward
            }
        }

        return totalWater;
    }
}
