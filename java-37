class Solution {
    public boolean isInterleave(String s1, String s2, String s3) {
        // If lengths do not match, s3 cannot be formed by interleaving s1 and s2
        if (s1.length() + s2.length() != s3.length()) {
            return false;
        }

        int m = s1.length();
        int n = s2.length();
        
        // dp[i][j] represents if s3[0...i+j-1] is formed by interleaving s1[0...i-1] and s2[0...j-1]
        boolean[][] dp = new boolean[m + 1][n + 1];

        // Base case: empty strings interleave to form an empty string
        dp[0][0] = true;

        // Fill the first column: using only characters from s1
        for (int i = 1; i <= m; i++) {
            dp[i][0] = dp[i - 1][0] && s1.charAt(i - 1) == s3.charAt(i - 1);
        }

        // Fill the first row: using only characters from s2
        for (int j = 1; j <= n; j++) {
            dp[0][j] = dp[0][j - 1] && s2.charAt(j - 1) == s3.charAt(j - 1);
        }

        // Fill the rest of the DP table
        for (int i = 1; i <= m; i++) {
            for (int j = 1; j <= n; j++) {
                // Case 1: Current character of s3 matches current character of s1
                boolean matchS1 = dp[i - 1][j] && s1.charAt(i - 1) == s3.charAt(i + j - 1);
                
                // Case 2: Current character of s3 matches current character of s2
                boolean matchS2 = dp[i][j - 1] && s2.charAt(j - 1) == s3.charAt(i + j - 1);

                // If either path is valid, then dp[i][j] is true
                dp[i][j] = matchS1 || matchS2;
            }
        }

        return dp[m][n];
    }
}
