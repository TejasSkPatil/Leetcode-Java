public class Section187 {
    public static void main(String[] args) {
        int a = 187;
        int b = 13;
        
        int quotient = a / b;
        int remainder = a % b;
        
        System.out.println("Quotient: " + quotient);
        System.out.println("Remainder: " + remainder);
    }
}



class Solution {
public:
    vector<int> parent;

    int find(int x) {
        if (parent[x] != x)
            parent[x] = find(parent[x]);
        return parent[x];
    }

    void unite(int a, int b) {
        a = find(a);
        b = find(b);
        if (a != b)
            parent[a] = b;
    }

    int minSwapsCouples(vector<int>& row) {
        int n = row.size() / 2;

        parent.resize(n);
        for (int i = 0; i < n; i++)
            parent[i] = i;

        for (int i = 0; i < row.size(); i += 2) {
            int c1 = row[i] / 2;
            int c2 = row[i + 1] / 2;
            unite(c1, c2);
        }

        unordered_map<int, int> components;
        for (int i = 0; i < n; i++)
            components[find(i)]++;

        int swaps = 0;
        for (auto &it : components)
            swaps += it.second - 1;

        return swaps;
    }
};
