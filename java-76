import java.util.HashMap;
import java.util.Map;

class Solution {
    public String minWindow(String s, String t) {
        // Return empty string if either input is invalid or s is shorter than t
        if (s == null || t == null || s.length() < t.length()) {
            return "";
        }

        // Map to store the character frequencies needed from string t
        Map<Character, Integer> targetMap = new HashMap<>();
        for (char c : t.toCharArray()) {
            targetMap.put(c, targetMap.getOrDefault(c, 0) + 1);
        }

        // Map to store character frequencies in the current sliding window of string s
        Map<Character, Integer> windowMap = new HashMap<>();

        // Tracks how many unique characters match the required frequencies in t
        int formed = 0;
        int required = targetMap.size();

        // Array to store window metrics: [window length, left pointer, right pointer]
        int[] ans = {-1, 0, 0};

        int left = 0;
        int right = 0;

        // Expand the sliding window by moving the right pointer
        while (right < s.length()) {
            char c = s.charAt(right);
            windowMap.put(c, windowMap.getOrDefault(c, 0) + 1);

            // If the frequency of the current character matches its requirement in t
            if (targetMap.containsKey(c) && windowMap.get(c).equals(targetMap.get(c))) {
                formed++;
            }

            // Try to contract the window from the left once it is valid
            while (left <= right && formed == required) {
                c = s.charAt(left);

                // Update the minimum window metrics if a smaller valid window is found
                if (ans[0] == -1 || (right - left + 1) < ans[0]) {
                    ans[0] = right - left + 1;
                    ans[1] = left;
                    ans[2] = right;
                }

                // Remove the left character from the window map
                windowMap.put(c, windowMap.get(c) - 1);
                
                // If removing the character breaks the validity condition, decrement 'formed'
                if (targetMap.containsKey(c) && windowMap.get(c) < targetMap.get(c)) {
                    formed--;
                }

                // Shrink the window
                left++;
            }

            // Expand the window
            right++;
        }

        // Return the smallest substring, or empty string if no valid window was found
        return ans[0] == -1 ? "" : s.substring(ans[1], ans[2] + 1);
    }
}
